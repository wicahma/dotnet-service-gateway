<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Performance Optimizations -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    
    <!-- AOT Ready -->
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    
    <!-- Container Configuration -->
    <ContainerBaseImage>registry.acc.co.id/devops/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
    <ContainerRepository>k8sgateway</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <!-- YARP - The Core Reverse Proxy -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />
    
    <!-- Serilog for Structured Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    
    <!-- Health Checks for Kubernetes Probes -->
    <PackageReference Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\K8sGateway.Core\K8sGateway.Core.csproj" />
    <ProjectReference Include="..\K8sGateway.Infrastructure\K8sGateway.Infrastructure.csproj" />
  </ItemGroup>

</Project>
