{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Yarp": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": null,
      "MaxConcurrentUpgradedConnections": null,
      "MaxRequestBodySize": 104857600,
      "MinRequestBodyDataRate": null,
      "MinResponseDataRate": null
    },
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "user_service_route": {
        "ClusterId": "user_service_cluster",
        "RateLimiterPolicy": "FixedWindowPolicy",
        "Match": {
          "Path": "/api/users/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/users" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api/users" }
        ]
      },
      "order_service_route": {
        "ClusterId": "order_service_cluster",
        "RateLimiterPolicy": "TokenBucketPolicy",
        "Match": {
          "Path": "/api/orders/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/orders" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api/orders" }
        ]
      },
      "product_service_route": {
        "ClusterId": "product_service_cluster",
        "RateLimiterPolicy": "SlidingWindowPolicy",
        "Match": {
          "Path": "/api/products/{**remainder}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/products" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api/products" }
        ]
      },
      "grpc_service_route": {
        "ClusterId": "grpc_cluster",
        "Match": {
          "Path": "/grpc/{**remainder}"
        },
        "Transforms": [{ "PathRemovePrefix": "/grpc" }],
        "Metadata": {
          "IsGrpc": "true"
        }
      },
      "websocket_service_route": {
        "ClusterId": "realtime_cluster",
        "Match": {
          "Path": "/ws/{**remainder}"
        },
        "Transforms": [{ "PathRemovePrefix": "/ws" }],
        "Metadata": {
          "IsWebSocket": "true"
        }
      },
      "catchall_route": {
        "ClusterId": "default_cluster",
        "Order": 10000,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "user_service_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://user-service.default.svc.cluster.local:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificateValidator": false,
          "MaxConnectionsPerServer": 1000,
          "RequestHeaderEncoding": "utf-8"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00",
          "AllowResponseBuffering": false
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        }
      },
      "order_service_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://order-service.default.svc.cluster.local:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificateValidator": false,
          "MaxConnectionsPerServer": 1000
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00",
          "AllowResponseBuffering": false
        }
      },
      "product_service_cluster": {
        "LoadBalancingPolicy": "LeastRequests",
        "Destinations": {
          "destination1": {
            "Address": "http://product-service.default.svc.cluster.local:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificateValidator": false,
          "MaxConnectionsPerServer": 1000
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:00",
          "AllowResponseBuffering": false
        }
      },
      "grpc_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://grpc-service.default.svc.cluster.local:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificateValidator": false,
          "MaxConnectionsPerServer": 500
        },
        "HttpRequest": {
          "Version": "2",
          "ActivityTimeout": "00:05:00",
          "AllowResponseBuffering": false
        }
      },
      "realtime_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://realtime-service.default.svc.cluster.local:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificateValidator": false,
          "MaxConnectionsPerServer": 2000
        },
        "HttpRequest": {
          "ActivityTimeout": "01:00:00",
          "AllowResponseBuffering": false
        }
      },
      "default_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://default-backend.default.svc.cluster.local:80"
          }
        }
      }
    }
  }
}
